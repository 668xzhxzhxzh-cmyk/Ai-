# Supabase Project URL, for example https://xxxx.supabase.co, not an API key.
SUPABASE_URL=

# Supabase anon public key or publishable key. Stored server-side for same-origin API auth.
SUPABASE_ANON_KEY=

# Supabase service_role key, server only.
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek API key, server only.
DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Production site URL, for example https://aishaoweng.cc.cd.
NEXT_PUBLIC_SITE_URL=

# Compatibility only: Vercel projects that already use these names still work.
# For new China deployments, prefer SUPABASE_URL and SUPABASE_ANON_KEY above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
