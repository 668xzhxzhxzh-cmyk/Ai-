# Supabase Project URL, for example https://xxxx.supabase.co, not an API key.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key or publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key, server only.
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek API key, server only.
DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Production site URL, for example https://aishaoweng.cc.cd.
NEXT_PUBLIC_SITE_URL=
